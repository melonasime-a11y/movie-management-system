# Copy this file to `.env` and adjust the values. Never commit `.env`.

# HTTP port (defaults to 3000).
PORT=3000

# Set to `production` in production. In production the app refuses to start
# unless JWT_SECRET is set to a real, non-placeholder value.
NODE_ENV=development

# SQLite database file path (defaults to `database.sqlite` in the working directory).
DATABASE_URL=database.sqlite

# Secret used to sign and verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Optional: NestJS Observe telemetry keys (written by `npx @nestjs/observe link`).
# Leave commented out to run without telemetry.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
